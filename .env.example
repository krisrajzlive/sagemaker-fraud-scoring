# Copy to .env (git-ignored). Credentials are NOT set here: AWS access comes from a named
# AWS CLI profile (run `aws configure --profile sandbox` in your own terminal, never in chat).
# Training and inference in local mode need no AWS credentials at all; they are only used by
# the S3 model registry and the JumpStart catalog explorer.
FRAUD_SCORING_AWS_PROFILE=sandbox
FRAUD_SCORING_AWS_REGION=us-east-1

# Where the dataset, processed splits and run artifacts live (relative to the working directory).
FRAUD_SCORING_DATA_DIR=data
FRAUD_SCORING_ARTIFACT_DIR=artifacts

# AWS Deep Learning Containers used for local mode. They are pulled anonymously from the
# ECR Public Gallery, so no `docker login` or AWS credentials are required.
FRAUD_SCORING_TRAINING_IMAGE=public.ecr.aws/deep-learning-containers/pytorch-training:2.5.1-cpu-py311-ubuntu22.04-sagemaker
FRAUD_SCORING_INFERENCE_IMAGE=public.ecr.aws/deep-learning-containers/pytorch-inference:2.5.1-cpu-py311-ubuntu22.04-sagemaker

# Private S3 bucket for the model registry (created by `fraud-scoring registry init`).
FRAUD_SCORING_S3_BUCKET=
